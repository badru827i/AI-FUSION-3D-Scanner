<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen camera canvas -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <com.aifusion.scanner.TrackingOverlayView
        android:id="@+id/trackingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <com.aifusion.scanner.HologramAnalysisOverlayView
        android:id="@+id/hologramOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Compact top status panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:background="#D910151D"
        android:elevation="6dp">

        <TextView
            android:id="@+id/deviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI-FUSION • Device Engine"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/scanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ready • tap an object to track"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Live 3D/depth preview; remains hidden until depth data is available -->
    <LinearLayout
        android:layout_width="148dp"
        android:layout_height="178dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:elevation="8dp"
        android:background="#E610151D"
        android:padding="4dp">

        <com.aifusion.scanner.Scan3DPreviewView
            android:id="@+id/miniPreview"
            android:layout_width="match_parent"
            android:layout_height="144dp" />

        <TextView
            android:id="@+id/coverageText"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="DEPTH • WAITING"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:background="#E610151D" />
    </LinearLayout>

    <!-- Floating controls panel; expanded/collapsed by the Scan Menu button -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="76dp"
        android:background="#E610151D"
        android:elevation="10dp">

    <!-- Responsive bottom dock: no fixed bottom offsets, works on short/tall screens -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#E610151D"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false">

            <Button
                android:id="@+id/turntableSetup"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="0dp"
                android:text="360 Setup"
                android:textSize="11sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />

            <Button
                android:id="@+id/completedModels"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:text="3D Models"
                android:textSize="11sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false">

            <Button
                android:id="@+id/meshMode"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="0dp"
                android:text="Mesh: POLYGON"
                android:textSize="10sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />

            <Button
                android:id="@+id/scanMode"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:text="Scan: AUTO"
                android:textSize="10sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false">

            <Button
                android:id="@+id/trackingLock"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="0dp"
                android:text="Lock Target"
                android:textSize="11sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />

            <Button
                android:id="@+id/saveModel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:text="Save Model"
                android:textSize="11sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/startScan"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="5dp"
            android:minHeight="0dp"
            android:text="Start 3D Scan"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/scanMenuButton"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:elevation="18dp"
        android:text="＋"
        android:textSize="26sp"
        android:textStyle="bold"
        android:contentDescription="Open scan controls" />
</FrameLayout>
