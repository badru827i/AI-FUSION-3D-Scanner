<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"
        app:implementationMode="performance" app:scaleType="fillCenter" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:orientation="vertical" android:padding="16dp"
        android:background="#AAFFFFFF">
        <TextView android:id="@+id/deviceStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Device Engine" android:textStyle="bold" android:textSize="16sp" />
        <TextView android:id="@+id/scanStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ready to scan" android:textSize="14sp" />
    </LinearLayout>
    <Button android:id="@+id/startScan" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="32dp" android:text="Start 3D Scan" />
</FrameLayout>
