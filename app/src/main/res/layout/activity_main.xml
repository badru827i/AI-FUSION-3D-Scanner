<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <com.aifusion.scanner.TrackingOverlayView
        android:id="@+id/trackingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <com.aifusion.scanner.HologramAnalysisOverlayView
        android:id="@+id/hologramOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/deviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="AI-FUSION • Device Engine"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Ready • point at the object"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="238dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_panel"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="8dp">

        <com.aifusion.scanner.Scan3DPreviewView
            android:id="@+id/miniPreview"
            android:layout_width="match_parent"
            android:layout_height="218dp" />

        <TextView
            android:id="@+id/coverageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#B20B1015"
            android:gravity="center"
            android:padding="5dp"
            android:text="0% • READY"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/denseTrackingButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="94dp"
        android:layout_marginEnd="12dp"
        android:backgroundTint="#D9182530"
        android:minHeight="44dp"
        android:text="Dense Track"
        android:textColor="#FFFFFFFF" />

    <LinearLayout
        android:id="@+id/exportActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="136dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="horizontal"
        android:padding="5dp"
        android:visibility="gone">

        <Button
            android:id="@+id/exportObj"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="#D9286570"
            android:minWidth="0dp"
            android:text="Save OBJ"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/exportGlb"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="#D9286570"
            android:minWidth="0dp"
            android:text="Save GLB"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/exportPly"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="#D9286570"
            android:minWidth="0dp"
            android:text="Save PLY"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/trackingLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="82dp"
        android:backgroundTint="#D9182530"
        android:text="Lock Target"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF" />

    <Button
        android:id="@+id/startScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#FF197A72"
        android:minHeight="48dp"
        android:text="Start 3D Scan"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold" />

    <com.aifusion.scanner.TrackingPointsView
        android:id="@+id/denseTrackingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
