<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D13">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <com.aifusion.scanner.TrackingOverlayView
        android:id="@+id/trackingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <com.aifusion.scanner.HologramAnalysisOverlayView
        android:id="@+id/hologramOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Lightweight translucent status panel; intentionally avoids real-time blur. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/glass_panel"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/deviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="AI-FUSION  •  DEVICE ENGINE"
            android:textColor="#FFF5FBFF"
            android:textSize="14sp"
            android:fontFamily="sans"
            android:letterSpacing="0.02"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Ready  •  point camera at an object"
            android:textColor="#FFD0DDE8"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Compact scan preview sits to the right so the live camera remains visible. -->
    <LinearLayout
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/glass_panel"
        android:elevation="5dp"
        android:orientation="vertical"
        android:padding="6dp">

        <com.aifusion.scanner.Scan3DPreviewView
            android:id="@+id/miniPreview"
            android:layout_width="match_parent"
            android:layout_height="136dp" />

        <TextView
            android:id="@+id/coverageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="5dp"
            android:text="0%  •  READY"
            android:textColor="#FFF5FBFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#66202D3A" />
    </LinearLayout>

    <!-- Bottom actions use large touch targets and native ripple, with no costly blur. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/glass_panel"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="10dp">

        <Button
            android:id="@+id/trackingLock"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/glass_button_secondary"
            android:fontFamily="sans"
            android:minHeight="50dp"
            android:text="◎   Lock Target"
            android:textAllCaps="false"
            android:textColor="#FFF5FBFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/startScan"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/glass_button_primary"
            android:fontFamily="sans"
            android:minHeight="54dp"
            android:text="Start 3D Scan"
            android:textAllCaps="false"
            android:textColor="#FF101923"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>